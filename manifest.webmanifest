{
  "name": "K-Trip Companion",
  "short_name": "K-Trip",
  "description": "Your guide in Korea: nearby places, routes, food, walking paths and audio stories.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f1ec",
  "theme_color": "#2f5d50",
  "lang": "en",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "dir": "ltr",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "categories": [
    "travel",
    "navigation"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Nearby temples",
      "short_name": "Temples",
      "url": "/?cat=temple",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}